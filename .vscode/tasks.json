{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Serve lebaptiste (Python)",
			"type": "shell",
			"command": "python3 -m http.server 8766 --bind 127.0.0.1",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "lebaptiste-http",
				"pattern": { "regexp": "^$" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Serving HTTP"
				}
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"showReuseMessage": false
			}
		}
	]
}
